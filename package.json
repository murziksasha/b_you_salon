{
  "name": "byou",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "start:next": "next start",
    "start:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-prod.ps1",
    "backup:offsite": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/backup-offsite.ps1",
    "seed:catalog": "node scripts/seed-catalog.mjs",
    "rotate-secrets": "node scripts/rotate-secrets.mjs",
    "pm2:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pm2-setup.ps1",
    "pm2:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pm2-autostart.ps1",
    "pm2:register-autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/register-autostart.ps1",
    "pm2:stop": "pm2 stop byou",
    "pm2:restart": "pm2 restart byou",
    "pm2:logs": "pm2 logs byou",
    "update": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/update-app.ps1",
    "seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "uploads:reprocess": "node scripts/reprocess-uploads.mjs",
    "uploads:reprocess:dry": "node scripts/reprocess-uploads.mjs --dry-run",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "docker:ps": "docker compose ps",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test e2e/smoke.spec.ts"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "next": "^15.0.0",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.77.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.51.1",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
