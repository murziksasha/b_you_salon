# B_You environment

ADMIN_PASSWORD=changeme
# REQUIRED in production: >= 32 chars, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-long-random-string
# Temporary migration escape hatch: allow ADMIN_PASSWORD / weak secret as signing key in prod (deprecated)
# ALLOW_LEGACY_SESSION_SECRET=false
# Secure cookies: set true for HTTPS (e.g. notebook host on KeenDNS HTTPS).
# For localhost / LAN HTTP leave false.
# Notebook host: COOKIE_SECURE=true
COOKIE_SECURE=false
ADMIN_IP_ALLOWLIST=

AUTO_BACKUP=true
BACKUP_KEEP=20

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=

# Public URL (sitemap, Open Graph, WhatsApp/Telegram preview, emails, PWA).
# Notebook host HTTPS origin (KeenDNS 4th-level domain):
# SITE_URL=https://beyou.properservice.keenetic.pro
# localhost here breaks link previews (og:image becomes http://localhost/…).
SITE_URL=http://localhost:8080
# Host port mapped to nginx (80 often requires admin on Windows)
NGINX_PORT=8080

# Host `npm run update` checks out this branch, then ff-pulls.
# GitHub default is `dev`. Override only if you deploy a different branch.
DEPLOY_BRANCH=dev

# Admin Telegram bot.
# Prefer HTTPS webhook: public SITE_URL + TELEGRAM_WEBHOOK_SECRET (openssl rand -hex 24).
# Next.js registers the webhook on boot. Long-poll (pm2 byou-telegram) is fallback
# when SITE_URL is not public https.
# Token is enough for pairing + commands. TELEGRAM_CHAT_ID is an optional fallback chat.
# Public SITE_URL (https, not localhost) is also required for the Viber redirect button
# and «Відкрити в адмінці». Copy-number still works without it.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
# ADMIN_TOTP_SECRET=

# Client IP trust for ADMIN_IP_ALLOWLIST: true = behind nginx/reverse proxy that overwrites
# X-Real-IP/X-Forwarded-For; false = Next.js exposed directly (headers ignored, allowlist fails closed).
# Unset = legacy (trust headers) with a warning.
# TRUST_PROXY=true

# Same-origin (CSRF) check for state-changing admin API. Set to false only for debugging.
# ADMIN_CSRF_CHECK=true

# Env ADMIN_PASSWORD login mode: always (default) | auto (disabled once an owner exists in admins.json)
# | breakglass (only with ADMIN_BREAKGLASS=1, audited + Telegram alert) | off
# Notebook host: ADMIN_ENV_LOGIN=off
# ADMIN_ENV_LOGIN=always
# ADMIN_BREAKGLASS=0

# ADMIN_REQUIRE_TOTP is ignored for admins.json users. Each file user has their own on/off.
# A file user with 2FA off logs in with a password only, even if the owner or global secret is on.
# Env / break-glass login still asks for ADMIN_TOTP_SECRET or data/admin-totp.json when that secret exists.
# ADMIN_REQUIRE_TOTP=false
