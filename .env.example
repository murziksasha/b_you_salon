# B_You environment

ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-long-random-string
COOKIE_SECURE=false
ADMIN_IP_ALLOWLIST=

AUTO_BACKUP=true
BACKUP_KEEP=20

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=

# Public URL (sitemap, Open Graph, emails). For Docker local:
SITE_URL=http://localhost:8080
# Host port mapped to nginx (80 often requires admin on Windows)
NGINX_PORT=8080

# Host `npm run update` checks out this branch, then ff-pulls.
# GitHub default is `dev`. Override only if you deploy a different branch.
DEPLOY_BRANCH=dev

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ADMIN_TOTP_SECRET=
